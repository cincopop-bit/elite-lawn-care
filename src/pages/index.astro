---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "LandscapingBusiness",
    "name": site.brand.name,
    "url": site.brand.siteUrl,
    "telephone": site.brand.phone,
    "email": site.brand.email,
    "areaServed": site.areas.map(a => ({ "@type": "City", "name": a.name, "addressRegion": "TX" })),
    "description": "Elite Lawn Care & Junk Removal provides professional tree trimming, landscaping, haul-off, junk removal, and emergency services across San Antonio, TX and surrounding communities.",
    "priceRange": "$$",
    "openingHours": "Mo-Sa 07:00-19:00",
    "sameAs": []
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": site.brand.name,
    "url": site.brand.siteUrl
  }
];
---

<Base
  title="Lawn Care & Junk Removal San Antonio TX"
  description="Elite Lawn Care & Junk Removal — San Antonio's trusted crew for tree trimming, landscaping, haul-off, junk removal, and emergency services. Free estimates. Same-day availability."
  schema={schema}
>

  <!-- HERO -->
  <section class="hero">
    <div class="container hero__content">
      <div class="hero__split">
        <div>
          <img src="/images/logo.png" alt="Elite Lawn Care & Junk Removal" class="hero__logo" />
          <p class="hero__eyebrow">San Antonio's Trusted Lawn & Junk Crew</p>
          <h1 class="hero__title">We Show Up.<br />We Do the Work.<br /><span class="text-green">You Relax.</span></h1>
        </div>
        <div>
          <p class="hero__desc" style="margin-top:3rem">From overgrown lots to storm cleanup, Elite handles every outdoor job homeowners and property managers need done right — and done fast. We serve San Antonio and 15 surrounding communities with same-day emergency response, free estimates, and a crew that actually shows up when they say they will. Tree trimming, landscaping, haul-offs, junk removal — one call handles it all.</p>
          <div class="hero__ctas">
            <a href="/contact" class="btn btn--primary btn--lg">Get a Free Estimate</a>
            <a href={`tel:${site.brand.phonePlain}`} class="btn btn--outline-white btn--lg">📞 {site.brand.phone}</a>
          </div>
          <p class="hero__trust">Free Estimates &nbsp;•&nbsp; Same-Day Emergency Service &nbsp;•&nbsp; Licensed &amp; Insured</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <div class="trust-bar">
    <div class="container">
      <div class="trust-bar__grid">
        {site.trustStats.map(s => (
          <div class="trust-item">
            <span class="trust-item__value">{s.value}</span>
            <span class="trust-item__label">{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- SERVICES -->
  <section class="section section--surface">
    <div class="container">
      <div class="section-header">
        <span class="section-header__eyebrow">What We Do</span>
        <h2 class="section-header__title">Full-Service Lawn Care & Cleanup</h2>
        <p class="section-header__desc">From routine maintenance to emergency storm cleanup — Elite handles every outdoor job homeowners and property managers need done right.</p>
      </div>
      <div class="grid-3">
        {site.services.map(s => (
          <a href={`/services/${s.slug}`} class="card service-card">
            <span class="card__icon">{s.icon}</span>
            <h3 class="card__title">{s.name}</h3>
            <p class="card__desc">{s.shortDesc}</p>
            <span class="card__link">Learn More →</span>
          </a>
        ))}
      </div>
      <div class="text-center" style="margin-top:3rem">
        <a href="/services" class="btn btn--outline">View All Services</a>
      </div>
    </div>
  </section>

  <!-- WHY ELITE -->
  <section class="section section--dark">
    <div class="container">
      <div class="grid-2 why-grid">
        <div class="why-content">
          <span class="section-header__eyebrow">Why Elite</span>
          <h2 style="color:var(--color-text-light);margin-bottom:1rem">We Show Up.<br /><span class="text-green">Every Time.</span></h2>
          <p style="color:var(--color-text-muted);margin-bottom:1.5rem">We built Elite on a simple promise — be the crew that actually shows up, does the job right, and leaves the property looking better than we found it. No games, no excuses.</p>
          <div style="margin-top:2rem;display:flex;gap:1rem;flex-wrap:wrap">
            <a href="/about" class="btn btn--outline">Our Story</a>
            <a href={`tel:${site.brand.phonePlain}`} class="btn btn--primary">📞 Call Now</a>
          </div>
        </div>
        <div class="why-bullets">
          <ul class="check-list check-list--large">
            <li>Serving San Antonio and 15 surrounding communities</li>
            <li>Same-day availability for emergency calls</li>
            <li>Residential and commercial property managers</li>
            <li>Full cleanup included on every job</li>
            <li>Free, no-obligation estimates</li>
            <li>Two lines — someone always answers</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICE AREAS PREVIEW -->
  <section class="section section--surface-mid">
    <div class="container">
      <div class="section-header">
        <span class="section-header__eyebrow">Where We Work</span>
        <h2 class="section-header__title">Serving Greater San Antonio</h2>
        <p class="section-header__desc" style="color:var(--color-text-muted)">{site.brand.serviceAreaDescription}</p>
      </div>
      <div class="areas-grid">
        {site.areas.map(a => (
          <a href={`/areas/${a.slug}`} class="area-chip">{a.name}</a>
        ))}
      </div>
      <div class="text-center" style="margin-top:2.5rem">
        <a href="/areas" class="btn btn--outline">All Service Areas</a>
      </div>
    </div>
  </section>

  <!-- CTA STRIP -->
  <div class="cta-strip">
    <div class="container">
      <h2 class="cta-strip__title">Ready to Cross It Off Your List?</h2>
      <p class="cta-strip__desc">Call or text for a free estimate. We respond fast — usually same day. Two numbers, someone always picks up.</p>
      <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap">
        <a href="/contact" class="btn btn--primary btn--lg">Get a Free Estimate</a>
        <a href={`tel:${site.brand.phonePlain}`} class="btn btn--outline btn--lg" style="border-color:var(--color-bg);color:var(--color-bg)">📞 {site.brand.phone}</a>
      </div>
      <p style="margin-top:1.5rem;color:rgba(0,0,0,0.6);font-size:0.9rem">Also available: {site.brand.phone2}</p>
    </div>
  </div>

</Base>

<style>
/* HERO */
.hero__logo {
  width: 380px;
  max-width: 100%;
  height: auto;
  margin-bottom: 0.4rem;
  display: block;
}

.hero__split {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem;
  align-items: center;
}

.hero__split > div:first-child {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

@media (min-width: 768px) {
  .hero__split { grid-template-columns: 1.15fr 0.85fr; gap: 4rem; }
}

.hero {
  position: relative;
  min-height: 600px;
  display: flex;
  align-items: center;
  overflow: hidden;
  background: var(--color-bg);
}

.hero__content {
  position: relative;
  z-index: 1;
  padding: 1.5rem 1rem;
  width: 100%;
  box-sizing: border-box;
}

@media (min-width: 768px) {
  .hero__content { padding: 1.5rem 3rem; }
}

.hero__eyebrow {
  font-family: var(--font-heading);
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--color-primary);
  margin-bottom: 0.75rem;
}

.hero__title {
  font-size: clamp(2rem, 8vw, var(--text-hero));
  color: var(--color-text-light);
  margin-bottom: 1.25rem;
  line-height: 1.1;
}

.hero__desc {
  font-size: 1.2rem;
  line-height: 1.8;
  color: var(--color-text-muted);
  margin-bottom: 2rem;
  max-width: 560px;
}

.hero__ctas {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
  margin-bottom: 1.5rem;
}

@media (min-width: 480px) {
  .hero__ctas { flex-wrap: nowrap; }
}

.hero__trust {
  font-size: 0.8rem;
  color: var(--color-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

/* SERVICE CARDS */
.service-card {
  display: flex;
  flex-direction: column;
  text-decoration: none;
}

.card__link {
  color: var(--color-primary);
  font-family: var(--font-heading);
  font-size: 0.9rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-top: auto;
}

/* WHY GRID */
.why-grid {
  align-items: center;
  gap: 4rem;
}

/* WHY BULLETS */
.why-bullets {
  display: flex;
  align-items: center;
}

.check-list--large li {
  font-size: 1.1rem;
  padding: 0.6rem 0;
  border-bottom: 1px solid var(--color-border-dark);
  color: var(--color-text-muted);
}

.check-list--large li:last-child {
  border-bottom: none;
}

/* AREAS GRID */
.areas-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  justify-content: center;
}

.area-chip {
  display: inline-block;
  padding: 0.5rem 1.25rem;
  background: var(--color-surface-dark);
  border: 1px solid var(--color-border-dark);
  border-radius: var(--radius-pill);
  color: var(--color-text-muted);
  font-family: var(--font-heading);
  font-size: 0.85rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  transition: all var(--transition);
  text-decoration: none;
}

.area-chip:hover {
  background: var(--color-primary);
  color: var(--color-bg);
  border-color: var(--color-primary);
}
</style>
