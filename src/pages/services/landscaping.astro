---
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';
const schema=[{"@context":"https://schema.org","@type":"Service","name":"Landscaping Services San Antonio TX","provider":{"@type":"LandscapingBusiness","name":site.brand.name,"telephone":site.brand.phone},"areaServed":site.areas.map(a=>({  "@type":"City","name":a.name,"addressRegion":"TX"})),"serviceType":"Landscaping","description":"Full-service landscaping in San Antonio TX including bed work, edging, mulching, and shrub trimming. Free estimates."},{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":site.brand.siteUrl},{"@type":"ListItem","position":2,"name":"Services","item":`${site.brand.siteUrl}/services`},{"@type":"ListItem","position":3,"name":"Landscaping","item":`${site.brand.siteUrl}/services/landscaping`}]}];
---
<Base title="Landscaping Services San Antonio TX" description="Professional landscaping in San Antonio TX — bed work, edging, mulching, shrub trimming, and more. Residential and commercial. Free estimates. Call (210) 997-7525." schema={schema} canonicalPath="/services/landscaping">
  <div class="page-hero">
    <div class="container">
      <nav class="breadcrumb"><a href="/">Home</a><span class="breadcrumb__sep">›</span><a href="/services">Services</a><span class="breadcrumb__sep">›</span><span>Landscaping</span></nav>
      <span class="page-hero__eyebrow">Landscaping</span>
      <h1 class="page-hero__title">Landscaping Services San Antonio, TX</h1>
      <p class="page-hero__desc">Clean edges, shaped shrubs, fresh beds — the details that separate a maintained yard from a neglected one. Elite handles the full picture.</p>
      <div style="display:flex;gap:1rem;flex-wrap:wrap"><a href="/contact" class="btn btn--primary">Get a Free Estimate</a><a href={`tel:${site.brand.phonePlain}`} class="btn btn--outline-white">📞 {site.brand.phone}</a></div>
    </div>
  </div>
  <section class="section section--surface">
    <div class="container">
      <div class="two-col">
        <div>
          <h2 style="margin-bottom:1rem">Curb Appeal That Lasts</h2>
          <p>A well-maintained landscape increases property value, keeps HOA citations at bay, and makes your home or business look like you care — because you do. Elite brings the skills and equipment to make it happen on schedule and on budget.</p>
          <p>We serve homeowners who want consistent monthly maintenance and property managers who need a reliable crew for multiple sites. Either way, the work gets done clean and on time.</p>
          <ul class="check-list" style="margin-top:1.5rem">
            <li>Shrub and hedge trimming and shaping</li>
            <li>Flower bed edging and cleanup</li>
            <li>Mulch installation and refresh</li>
            <li>Lawn edging along driveways and walkways</li>
            <li>Ground cover and weed clearing</li>
            <li>Seasonal bed cleanup</li>
            <li>Property manager recurring maintenance programs</li>
          </ul>
        </div>
        <div><img src="/images/work-2.jpg" alt="Landscaping and hedge trimming in San Antonio" style="width:100%;height:400px;object-fit:cover;border-radius:16px" /></div>
      </div>
    </div>
  </section>
  <div class="cta-strip">
    <div class="container">
      <h2 class="cta-strip__title">Ready to Upgrade Your Curb Appeal?</h2>
      <p class="cta-strip__desc">Call for a free estimate. We'll walk the property and give you a straight quote.</p>
      <a href={`tel:${site.brand.phonePlain}`} class="btn btn--primary btn--lg">📞 {site.brand.phone}</a>
    </div>
  </div>
</Base>
<style>.two-col{display:grid;grid-template-columns:1fr;gap:3rem;align-items:center}@media(min-width:768px){.two-col{grid-template-columns:1fr 1fr}}</style>
