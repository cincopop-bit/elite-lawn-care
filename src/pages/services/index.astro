---
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Lawn Care & Junk Removal Services — San Antonio, TX",
  "description": "Full list of outdoor services offered by Elite Lawn Care & Junk Removal across San Antonio, TX and surrounding communities.",
  "url": `${site.brand.siteUrl}/services`,
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": site.brand.siteUrl },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": `${site.brand.siteUrl}/services` }
    ]
  }
};
---

<Base
  title="Services — Lawn Care, Tree Trimming & Junk Removal"
  description="Elite Lawn Care & Junk Removal offers tree trimming, landscaping, haul-off, junk removal, and emergency services across San Antonio, TX. Get a free estimate today."
  schema={schema}
  canonicalPath="/services"
>

  <div class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">›</span>
        <span>Services</span>
      </nav>
      <span class="page-hero__eyebrow">What We Do</span>
      <h1 class="page-hero__title">Full-Service Outdoor Solutions</h1>
      <p class="page-hero__desc">From weekly lawn maintenance to full property cleanouts — Elite handles everything. One crew, one call, done right.</p>
    </div>
  </div>

  <section class="section section--surface">
    <div class="container">
      <div class="services-list">
        {site.services.map((s, i) => (
          <a href={`/services/${s.slug}`} class="service-row">
            <div class="service-row__icon">{s.icon}</div>
            <div class="service-row__body">
              <h2 class="service-row__title">{s.name}</h2>
              <p class="service-row__desc">{s.shortDesc}</p>
            </div>
            <div class="service-row__arrow">→</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="cta-strip">
    <div class="container">
      <h2 class="cta-strip__title">Not Sure What You Need?</h2>
      <p class="cta-strip__desc">Call us and describe the job. We'll give you a straight answer and a free estimate — no pressure, no pitch.</p>
      <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap">
        <a href={`tel:${site.brand.phonePlain}`} class="btn btn--primary btn--lg">📞 {site.brand.phone}</a>
        <a href="/contact" class="btn btn--outline btn--lg" style="border-color:var(--color-bg);color:var(--color-bg)">Send a Message</a>
      </div>
    </div>
  </div>

</Base>

<style>
.services-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.service-row {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  padding: 2rem;
  background: var(--color-text-light);
  border-radius: var(--radius-lg);
  border-left: 4px solid transparent;
  box-shadow: var(--shadow-card);
  text-decoration: none;
  transition: all var(--transition);
}

.service-row:hover {
  border-left-color: var(--color-primary);
  box-shadow: var(--shadow-elevated);
  transform: translateX(4px);
}

.service-row__icon {
  font-size: 2.5rem;
  flex-shrink: 0;
}

.service-row__body { flex: 1; }

.service-row__title {
  font-size: 1.4rem;
  color: var(--color-text-dark);
  margin-bottom: 0.4rem;
}

.service-row__desc {
  color: var(--color-text-muted-dark);
  margin: 0;
  font-size: 0.95rem;
}

.service-row__arrow {
  font-size: 1.5rem;
  color: var(--color-primary);
  font-weight: 700;
  flex-shrink: 0;
}
</style>
