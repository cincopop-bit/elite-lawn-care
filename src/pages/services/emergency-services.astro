---
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';
const schema=[{"@context":"https://schema.org","@type":"Service","name":"Emergency Lawn Care San Antonio TX","provider":{"@type":"LandscapingBusiness","name":site.brand.name,"telephone":site.brand.phone},"areaServed":site.areas.map(a=>({"@type":"City","name":a.name,"addressRegion":"TX"})),"serviceType":"Emergency Lawn and Tree Services","description":"Same-day emergency lawn care, storm cleanup, and fallen tree removal in San Antonio TX. Available when you need it most."},{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":site.brand.siteUrl},{"@type":"ListItem","position":2,"name":"Services","item":`${site.brand.siteUrl}/services`},{"@type":"ListItem","position":3,"name":"Emergency Services","item":`${site.brand.siteUrl}/services/emergency-services`}]}];
---
<Base title="Emergency Lawn & Tree Services San Antonio TX" description="Same-day emergency lawn care and storm cleanup in San Antonio TX. Fallen trees, storm debris, urgent yard clearing. Available now. Call (210) 997-7525." schema={schema} canonicalPath="/services/emergency-services">
  <div class="page-hero" style="background:linear-gradient(135deg,#1a0000 0%,#2d0000 50%,var(--color-surface-dark) 100%)">
    <div class="container">
      <nav class="breadcrumb"><a href="/">Home</a><span class="breadcrumb__sep">›</span><a href="/services">Services</a><span class="breadcrumb__sep">›</span><span>Emergency Services</span></nav>
      <span class="page-hero__eyebrow" style="color:#FF6B35">⚡ Emergency Response</span>
      <h1 class="page-hero__title">Emergency Services San Antonio, TX</h1>
      <p class="page-hero__desc">Storm knocked a tree over your driveway? Flood left your yard buried? We respond same-day. Call now — someone always picks up.</p>
      <div style="display:flex;gap:1rem;flex-wrap:wrap">
        <a href={`tel:${site.brand.phonePlain}`} class="btn btn--primary btn--lg">📞 Call Now: {site.brand.phone}</a>
        <a href={`tel:${site.brand.phone2Plain}`} class="btn btn--outline-white btn--lg">Also: {site.brand.phone2}</a>
      </div>
    </div>
  </div>
  <section class="section section--surface">
    <div class="container">
      <div class="grid-3">
        {[["🌪️","Storm Cleanup","Fallen limbs, scattered debris, and storm damage cleared fast after severe weather events."],["🌳","Fallen Tree Removal","Trees down on driveways, fences, or structures removed safely and completely."],["🏃","Same-Day Response","We prioritize emergency calls. Call either number — we'll tell you when we can be there."]].map(([icon,title,desc])=>(
          <div class="card">
            <span class="card__icon">{icon}</span>
            <h3 class="card__title">{title}</h3>
            <p class="card__desc">{desc}</p>
          </div>
        ))}
      </div>
      <div style="margin-top:4rem;padding:2rem;background:var(--color-text-light);border-radius:16px;border-left:4px solid var(--color-primary);box-shadow:var(--shadow-card)">
        <h3 style="margin-bottom:.75rem">Two Numbers. Someone Always Answers.</h3>
        <p style="color:var(--color-text-muted-dark);margin-bottom:1.5rem">We keep two active lines specifically so emergency calls don't go unanswered. If one is busy, the other picks up. We know a storm doesn't wait for a callback window.</p>
        <div style="display:flex;gap:1rem;flex-wrap:wrap">
          <a href={`tel:${site.brand.phonePlain}`} class="btn btn--primary">{site.brand.phone}</a>
          <a href={`tel:${site.brand.phone2Plain}`} class="btn btn--outline">{site.brand.phone2}</a>
        </div>
      </div>
    </div>
  </section>
</Base>
