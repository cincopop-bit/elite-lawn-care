---
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "LandscapingBusiness",
    "name": "Elite Lawn Care & Junk Removal",
    "url": "https://elitelawncaresa.com",
    "telephone": "(210) 997-7525",
    "email": "elitelawncaresa@gmail.com",
    "areaServed": {
      "@type": "City",
      "name": "New Braunfels",
      "addressRegion": "TX"
    },
    "description": "Elite serves New Braunfels with professional lawn care, storm cleanup, tree trimming, and junk removal across the Comal and Guadalupe River communities."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://elitelawncaresa.com"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Service Areas",
        "item": "https://elitelawncaresa.com/areas"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "New Braunfels",
        "item": "https://elitelawncaresa.com/areas/new-braunfels"
      }
    ]
  }
];
---

<Base
  title="Lawn Care & Junk Removal New Braunfels, TX"
  description="Elite serves New Braunfels with professional lawn care, storm cleanup, tree trimming, and junk removal across the Comal and Guadalupe River communities."
  schema={schema}
  canonicalPath="/areas/new-braunfels"
>

  <div class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">›</span>
        <a href="/areas">Service Areas</a>
        <span class="breadcrumb__sep">›</span>
        <span>New Braunfels</span>
      </nav>
      <span class="page-hero__eyebrow">Service Area</span>
      <h1 class="page-hero__title">Lawn Care & Junk Removal New Braunfels, TX</h1>
      <p class="page-hero__desc">Elite serves New Braunfels with professional lawn care, storm cleanup, tree trimming, and junk removal across the Comal and Guadalupe River communities.</p>
      <div style="display:flex;gap:1rem;flex-wrap:wrap">
        <a href="/contact" class="btn btn--primary">Get a Free Estimate</a>
        <a href="tel:2109977525" class="btn btn--outline-white">📞 (210) 997-7525</a>
      </div>
    </div>
  </div>

  <section class="section section--surface">
    <div class="container">
      <div class="two-col">
        <div>
          <span class="section-header__eyebrow">Serving New Braunfels, TX</span>
          <h2 style="margin-bottom:1rem">Elite in New Braunfels</h2>
          <p>New Braunfels has become one of the fastest-growing cities in the country, and with that growth comes an enormous demand for reliable outdoor services. From the historic German heritage neighborhoods near downtown to the massive new developments like Veramendi, Elite serves it all.</p>
          <p>The Comal and Guadalupe Rivers mean storm and flood cleanup is a real, recurring need here. Elite responds fast when weather events hit — we know how to clear debris efficiently and help properties recover quickly.</p>
          <ul class="check-list" style="margin-top:1.5rem">
            <li>Lawn maintenance for new and established properties</li>
            <li>Storm and flood cleanup along river corridors</li>
            <li>Tree trimming for mature riverside canopy</li>
            <li>New development landscaping establishment</li>
            <li>Junk removal for growing population of new residents</li>
            <li>Rental property and short-term rental cleanouts</li>
          </ul>
        </div>
        <div class="side-photo">
          <img src="/images/work-1.jpg" alt="Lawn care service in New Braunfels, TX" />
          <div class="contact-card">
            <h3>Get a Free Estimate in New Braunfels</h3>
            <p>Call or text — we respond fast.</p>
            <a href="tel:2109977525" class="btn btn--primary" style="width:100%;text-align:center;margin-bottom:.75rem">📞 (210) 997-7525</a>
            <a href="/contact" class="btn btn--outline" style="width:100%;text-align:center">Send a Message</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <div class="section-header">
        <span class="section-header__eyebrow">All Services in New Braunfels</span>
        <h2 class="section-header__title">What Elite Does in New Braunfels</h2>
      </div>
      <div class="grid-3">
        {site.services.map(s => (
          <a href={`/services/${s.slug}`} class="card card--dark" style="text-decoration:none">
            <span class="card__icon">{s.icon}</span>
            <h3 class="card__title">{s.name}</h3>
            <p class="card__desc">{s.shortDesc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--surface-mid">
    <div class="container">
      <p style="color:var(--color-text-muted);font-size:.95rem;max-width:700px">We serve all of New Braunfels including Veramendi, Vintage Oaks, Creekside, the downtown historic district, and surrounding Comal County communities.</p>
    </div>
  </section>

  <div class="cta-strip">
    <div class="container">
      <h2 class="cta-strip__title">Ready to Get Started in New Braunfels?</h2>
      <p class="cta-strip__desc">Call for a free estimate. We respond fast — usually same day.</p>
      <a href="tel:2109977525" class="btn btn--primary btn--lg">📞 (210) 997-7525</a>
    </div>
  </div>

</Base>

<style>
.two-col { display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: start; }
@media (min-width: 768px) { .two-col { grid-template-columns: 1fr 1fr; } }
.side-photo img { width: 100%; height: 280px; object-fit: cover; border-radius: var(--radius-lg); margin-bottom: 1.5rem; }
.contact-card { background: var(--color-text-light); padding: 1.5rem; border-radius: var(--radius-lg); box-shadow: var(--shadow-card); border-top: 3px solid var(--color-primary); }
.contact-card h3 { font-size: 1.1rem; margin-bottom: .5rem; }
.contact-card p { color: var(--color-text-muted-dark); font-size: .9rem; margin-bottom: 1rem; }
</style>
