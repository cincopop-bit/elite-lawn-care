---
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "LandscapingBusiness",
    "name": "Elite Lawn Care & Junk Removal",
    "url": "https://elitelawncaresa.com",
    "telephone": "(210) 997-7525",
    "email": "elitelawncaresa@gmail.com",
    "areaServed": {
      "@type": "City",
      "name": "San Antonio",
      "addressRegion": "TX"
    },
    "description": "San Antonio's most dependable outdoor crew — covering everything from Stone Oak to Southtown, Alamo Ranch to the Medical Center. Elite shows up, does the work, and leaves it clean."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://elitelawncaresa.com"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Service Areas",
        "item": "https://elitelawncaresa.com/areas"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "San Antonio",
        "item": "https://elitelawncaresa.com/areas/san-antonio"
      }
    ]
  }
];
---

<Base
  title="Lawn Care & Junk Removal San Antonio, TX"
  description="San Antonio's most dependable outdoor crew — covering everything from Stone Oak to Southtown, Alamo Ranch to the Medical Center. Elite shows up, does the work, and leaves it clean."
  schema={schema}
  canonicalPath="/areas/san-antonio"
>

  <div class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">›</span>
        <a href="/areas">Service Areas</a>
        <span class="breadcrumb__sep">›</span>
        <span>San Antonio</span>
      </nav>
      <span class="page-hero__eyebrow">Service Area</span>
      <h1 class="page-hero__title">Lawn Care & Junk Removal San Antonio, TX</h1>
      <p class="page-hero__desc">San Antonio's most dependable outdoor crew — covering everything from Stone Oak to Southtown, Alamo Ranch to the Medical Center. Elite shows up, does the work, and leaves it clean.</p>
      <div style="display:flex;gap:1rem;flex-wrap:wrap">
        <a href="/contact" class="btn btn--primary">Get a Free Estimate</a>
        <a href="tel:2109977525" class="btn btn--outline-white">📞 (210) 997-7525</a>
      </div>
    </div>
  </div>

  <section class="section section--surface">
    <div class="container">
      <div class="two-col">
        <div>
          <span class="section-header__eyebrow">Serving San Antonio, TX</span>
          <h2 style="margin-bottom:1rem">Elite in San Antonio</h2>
          <p>San Antonio is home to some of Texas's most demanding lawn care conditions — intense summer heat, caliche soil, water restrictions from SAWS, and live oak trees that drop leaves in spring instead of fall. Elite Lawn Care & Junk Removal knows this city's landscape because we work in it every week.</p>
          <p>Whether you're in a Stone Oak neighborhood dealing with HOA citations, a Southtown property manager needing reliable service across multiple buildings, or a homeowner in Alamo Ranch looking for a crew that actually shows up — Elite handles it.</p>
          <ul class="check-list" style="margin-top:1.5rem">
            <li>Live oak and cedar elm trimming</li>
            <li>St. Augustine and Bermuda lawn maintenance</li>
            <li>SAWS water restriction-aware service</li>
            <li>HOA compliance mowing and edging</li>
            <li>Same-day storm cleanup after severe weather</li>
            <li>Junk removal for home cleanouts and estate sales</li>
          </ul>
        </div>
        <div class="side-photo">
          <img src="/images/work-1.jpg" alt="Lawn care service in San Antonio, TX" />
          <div class="contact-card">
            <h3>Get a Free Estimate in San Antonio</h3>
            <p>Call or text — we respond fast.</p>
            <a href="tel:2109977525" class="btn btn--primary" style="width:100%;text-align:center;margin-bottom:.75rem">📞 (210) 997-7525</a>
            <a href="/contact" class="btn btn--outline" style="width:100%;text-align:center">Send a Message</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <div class="section-header">
        <span class="section-header__eyebrow">All Services in San Antonio</span>
        <h2 class="section-header__title">What Elite Does in San Antonio</h2>
      </div>
      <div class="grid-3">
        {site.services.map(s => (
          <a href={`/services/${s.slug}`} class="card card--dark" style="text-decoration:none">
            <span class="card__icon">{s.icon}</span>
            <h3 class="card__title">{s.name}</h3>
            <p class="card__desc">{s.shortDesc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--surface-mid">
    <div class="container">
      <p style="color:var(--color-text-muted);font-size:.95rem;max-width:700px">We serve neighborhoods across the full city — Stone Oak, Alamo Ranch, Helotes, Southtown, Medical Center, Thousand Oaks, Shavano Park, Northside, and everywhere in between.</p>
    </div>
  </section>

  <div class="cta-strip">
    <div class="container">
      <h2 class="cta-strip__title">Ready to Get Started in San Antonio?</h2>
      <p class="cta-strip__desc">Call for a free estimate. We respond fast — usually same day.</p>
      <a href="tel:2109977525" class="btn btn--primary btn--lg">📞 (210) 997-7525</a>
    </div>
  </div>

</Base>

<style>
.two-col { display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: start; }
@media (min-width: 768px) { .two-col { grid-template-columns: 1fr 1fr; } }
.side-photo img { width: 100%; height: 280px; object-fit: cover; border-radius: var(--radius-lg); margin-bottom: 1.5rem; }
.contact-card { background: var(--color-text-light); padding: 1.5rem; border-radius: var(--radius-lg); box-shadow: var(--shadow-card); border-top: 3px solid var(--color-primary); }
.contact-card h3 { font-size: 1.1rem; margin-bottom: .5rem; }
.contact-card p { color: var(--color-text-muted-dark); font-size: .9rem; margin-bottom: 1rem; }
</style>
