---
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "LandscapingBusiness",
    "name": "Elite Lawn Care & Junk Removal",
    "url": "https://elitelawncaresa.com",
    "telephone": "(210) 997-7525",
    "email": "elitelawncaresa@gmail.com",
    "areaServed": {
      "@type": "City",
      "name": "Leon Valley",
      "addressRegion": "TX"
    },
    "description": "Elite serves Leon Valley with professional lawn care, tree trimming, and junk removal for the northwest San Antonio suburb."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://elitelawncaresa.com"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Service Areas",
        "item": "https://elitelawncaresa.com/areas"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Leon Valley",
        "item": "https://elitelawncaresa.com/areas/leon-valley"
      }
    ]
  }
];
---

<Base
  title="Lawn Care & Junk Removal Leon Valley, TX"
  description="Elite serves Leon Valley with professional lawn care, tree trimming, and junk removal for the northwest San Antonio suburb."
  schema={schema}
  canonicalPath="/areas/leon-valley"
>

  <div class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">›</span>
        <a href="/areas">Service Areas</a>
        <span class="breadcrumb__sep">›</span>
        <span>Leon Valley</span>
      </nav>
      <span class="page-hero__eyebrow">Service Area</span>
      <h1 class="page-hero__title">Lawn Care & Junk Removal Leon Valley, TX</h1>
      <p class="page-hero__desc">Elite serves Leon Valley with professional lawn care, tree trimming, and junk removal for the northwest San Antonio suburb.</p>
      <div style="display:flex;gap:1rem;flex-wrap:wrap">
        <a href="/contact" class="btn btn--primary">Get a Free Estimate</a>
        <a href="tel:2109977525" class="btn btn--outline-white">📞 (210) 997-7525</a>
      </div>
    </div>
  </div>

  <section class="section section--surface">
    <div class="container">
      <div class="two-col">
        <div>
          <span class="section-header__eyebrow">Serving Leon Valley, TX</span>
          <h2 style="margin-bottom:1rem">Elite in Leon Valley</h2>
          <p>Leon Valley is an established suburb with mature trees, older lots, and the kind of accumulated deferred maintenance that builds up over years. Elite specializes in restoring overgrown properties and keeping them on a reliable maintenance schedule going forward.</p>
          <p>Leon Creek runs through the area and brings seasonal flood debris that needs clearing. Elite responds quickly to post-storm cleanup calls and handles the kind of heavy clearing that standard lawn crews can't manage.</p>
          <ul class="check-list" style="margin-top:1.5rem">
            <li>Established lawn maintenance and edging</li>
            <li>Mature tree trimming and limb removal</li>
            <li>Leon Creek corridor debris cleanup</li>
            <li>Overgrown property restoration</li>
            <li>City code compliance lawn care</li>
            <li>Junk removal before home sales</li>
          </ul>
        </div>
        <div class="side-photo">
          <img src="/images/work-1.jpg" alt="Lawn care service in Leon Valley, TX" />
          <div class="contact-card">
            <h3>Get a Free Estimate in Leon Valley</h3>
            <p>Call or text — we respond fast.</p>
            <a href="tel:2109977525" class="btn btn--primary" style="width:100%;text-align:center;margin-bottom:.75rem">📞 (210) 997-7525</a>
            <a href="/contact" class="btn btn--outline" style="width:100%;text-align:center">Send a Message</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <div class="section-header">
        <span class="section-header__eyebrow">All Services in Leon Valley</span>
        <h2 class="section-header__title">What Elite Does in Leon Valley</h2>
      </div>
      <div class="grid-3">
        {site.services.map(s => (
          <a href={`/services/${s.slug}`} class="card card--dark" style="text-decoration:none">
            <span class="card__icon">{s.icon}</span>
            <h3 class="card__title">{s.name}</h3>
            <p class="card__desc">{s.shortDesc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--surface-mid">
    <div class="container">
      <p style="color:var(--color-text-muted);font-size:.95rem;max-width:700px">We serve all of Leon Valley and surrounding northwest San Antonio communities including Shavano Park, Balcones Heights, and Windcrest-adjacent areas.</p>
    </div>
  </section>

  <div class="cta-strip">
    <div class="container">
      <h2 class="cta-strip__title">Ready to Get Started in Leon Valley?</h2>
      <p class="cta-strip__desc">Call for a free estimate. We respond fast — usually same day.</p>
      <a href="tel:2109977525" class="btn btn--primary btn--lg">📞 (210) 997-7525</a>
    </div>
  </div>

</Base>

<style>
.two-col { display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: start; }
@media (min-width: 768px) { .two-col { grid-template-columns: 1fr 1fr; } }
.side-photo img { width: 100%; height: 280px; object-fit: cover; border-radius: var(--radius-lg); margin-bottom: 1.5rem; }
.contact-card { background: var(--color-text-light); padding: 1.5rem; border-radius: var(--radius-lg); box-shadow: var(--shadow-card); border-top: 3px solid var(--color-primary); }
.contact-card h3 { font-size: 1.1rem; margin-bottom: .5rem; }
.contact-card p { color: var(--color-text-muted-dark); font-size: .9rem; margin-bottom: 1rem; }
</style>
